@startuml deployment

title Vista de despliegue — Modelo de despliegue (Entrega 1, Minikube)
skinparam shadowing false
skinparam backgroundColor white
skinparam roundCorner 10
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 30
skinparam ArrowColor #1B1B1B
skinparam hexagon {
  BackgroundColor #FCE4EC
  BorderColor #C2185B
}
skinparam database {
  BackgroundColor #2F5FA8
  FontColor white
  BorderColor #1B3B6F
}
skinparam component {
  BackgroundColor #BBDEFB
  BorderColor #1565C0
}
skinparam artifact {
  BackgroundColor #FAFAFA
  BorderColor #616161
}
skinparam frame {
  BackgroundColor #FFFFFF
  BorderColor #2E7D32
  FontColor #2E7D32
}
skinparam legend {
  BackgroundColor #FCE8A8
  BorderColor #1B1B1B
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #1B1B1B
}
skinparam cloud {
  FontSize 26
  BackgroundColor #F5F5F5
  BorderColor #616161
}

cloud "Internet" as client

frame "K8s — namespace: default" {

  frame " " as offers_group #line:white {
    frame "offers-app" as offers_app_pod <<Pod>> {
      frame "Contenedor" as offers_app_ctr_f {
        hexagon "offers_app" as offers_app_img
      }
    }
    component "offers-app-service" as offers_app_svc <<NodePort 30003>>
    frame "offers-db" as offers_db_pod <<Pod>> {
      frame "Contenedor" as offers_db_ctr_f {
        database "offers_db" as offers_db_img
      }
    }
    component "offers-db-service" as offers_db_svc
    artifact "offers-db-volumen" as offers_db_vol
  }

  frame " " as routes_group #line:white {
    frame "routes-app" as routes_app_pod <<Pod>> {
      frame "Contenedor" as routes_app_ctr_f {
        hexagon "routes_app" as routes_app_img
      }
    }
    component "routes-app-service" as routes_app_svc <<NodePort 30002>>
    frame "routes-db" as routes_db_pod <<Pod>> {
      frame "Contenedor" as routes_db_ctr_f {
        database "routes_db" as routes_db_img
      }
    }
    component "routes-db-service" as routes_db_svc
    artifact "routes-db-volumen" as routes_db_vol
  }

  frame " " as posts_group #line:white {
    frame "posts-app" as posts_app_pod <<Pod>> {
      frame "Contenedor" as posts_app_ctr_f {
        hexagon "posts_app" as posts_app_img
      }
    }
    component "posts-app-service" as posts_app_svc <<NodePort 30001>>
    frame "posts-db" as posts_db_pod <<Pod>> {
      frame "Contenedor" as posts_db_ctr_f {
        database "posts_db" as posts_db_img
      }
    }
    component "posts-db-service" as posts_db_svc
    artifact "posts-db-volumen" as posts_db_vol
  }

  frame " " as users_group #line:white {
    frame "users-app" as users_app_pod <<Pod>> {
      frame "Contenedor" as users_app_ctr_f {
        hexagon "users_app" as users_app_img
      }
    }
    component "users-app-service" as users_app_svc <<NodePort 30000>>
    frame "users-db" as users_db_pod <<Pod>> {
      frame "Contenedor" as users_db_ctr_f {
        database "users_db" as users_db_img
      }
    }
    component "users-db-service" as users_db_svc
    artifact "users-db-volumen" as users_db_vol
  }
}

client .down.> users_app_svc
client .down.> posts_app_svc
client .down.> routes_app_svc
client .down.> offers_app_svc

users_app_svc  -down-> users_app_pod  : "80 -> 9000"
posts_app_svc  -down-> posts_app_pod  : "80 -> 9000"
routes_app_svc -down-> routes_app_pod : "80 -> 9000"
offers_app_svc -down-> offers_app_pod : "80 -> 9000"

users_app_pod  -down-> users_db_svc  : "5432"
posts_app_pod  -down-> posts_db_svc  : "5432"
routes_app_pod -down-> routes_db_svc : "5432"
offers_app_pod -down-> offers_db_svc : "5432"

users_db_svc  -down-> users_db_pod
posts_db_svc  -down-> posts_db_pod
routes_db_svc -down-> routes_db_pod
offers_db_svc -down-> offers_db_pod

users_db_pod  -down-> users_db_vol  : mount
posts_db_pod  -down-> posts_db_vol  : mount
routes_db_pod -down-> routes_db_vol : mount
offers_db_pod -down-> offers_db_vol : mount

legend left
  <b>Convenciones
  ----
  [ Pod ]  frame verde, agrupa un contenedor
  [ Contenedor ]  hexágono rosa (app) o cilindro azul (Postgres)
  Azul claro  Service - K8s (NodePort o ClusterIP)
  Documento gris  volumen emptyDir montado en el pod
  ..> Comunicación externa (NodePort, fuera del clúster)
  --> Comunicación interna (dentro del clúster)
endlegend

@enduml
