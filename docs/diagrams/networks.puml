@startuml networks

title Vista de despliegue — Modelo de red (Entrega 1, NetworkPolicy por app)
left to right direction
skinparam componentStyle rectangle

frame "users_app" as users_app_zone {
  component "users-app" as users_app_pod
  component "users-app-service" as users_app_svc
}
frame "users_db" as users_db_zone {
  component "users-db" as users_db_pod
  component "users-db-service" as users_db_svc
}
users_app_svc -down-> users_db_svc : "5432\n(users-network)"

frame "posts_app" as posts_app_zone {
  component "posts-app" as posts_app_pod
  component "posts-app-service" as posts_app_svc
}
frame "posts_db" as posts_db_zone {
  component "posts-db" as posts_db_pod
  component "posts-db-service" as posts_db_svc
}
posts_app_svc -down-> posts_db_svc : "5432\n(posts-network)"

frame "offers_app" as offers_app_zone {
  component "offers-app" as offers_app_pod
  component "offers-app-service" as offers_app_svc
}
frame "offers_db" as offers_db_zone {
  component "offers-db" as offers_db_pod
  component "offers-db-service" as offers_db_svc
}
offers_app_svc -down-> offers_db_svc : "5432\n(offers-network)"

frame "routes_app" as routes_app_zone {
  component "routes-app" as routes_app_pod
  component "routes-app-service" as routes_app_svc
}
frame "routes_db" as routes_db_zone {
  component "routes-db" as routes_db_pod
  component "routes-db-service" as routes_db_svc
}
routes_app_svc -down-> routes_db_svc : "5432\n(routes-network)"

note as legend
  Cada NetworkPolicy (<app>-network) solo permite ingreso al
  Service de base de datos correspondiente desde el pod de su
  propia aplicación, puerto 5432. Cualquier otra combinación
  cruzada (p. ej. posts-app -> users-db) está bloqueada por
  defecto: no existe ninguna regla de ingreso que la autorice.
end note

@enduml
