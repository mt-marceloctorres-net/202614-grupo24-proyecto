@startuml networks

title Vista de despliegue — Modelo de red (Entrega 1, NetworkPolicy por app)
skinparam shadowing false
skinparam backgroundColor white
skinparam roundCorner 8
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 35
skinparam ArrowColor #1B1B1B
skinparam component {
  BackgroundColor #BBDEFB
  BorderColor #1565C0
}
skinparam hexagon {
  BackgroundColor #FCE4EC
  BorderColor #C2185B
}
skinparam database {
  BackgroundColor #2F5FA8
  FontColor white
  BorderColor #1B3B6F
}
skinparam frame {
  BackgroundColor #FFFFFF
  BorderColor #2E7D32
  FontColor #2E7D32
}
skinparam legend {
  BackgroundColor #FCE8A8
  BorderColor #1B1B1B
}

cloud "Internet" as client

frame "K8s" as k8s_frame #line.dashed {
 frame "Node" {

  frame "users-network" {
    frame "users_app" as users_app_zone {
      component "users-app-service" as users_app_svc
      frame "users-app" as users_app_pod <<Pod>> {
        frame "Contenedor" as users_app_ctr_f {
          hexagon "users_app" as users_app_ctr
        }
      }
    }
    frame "users_db" as users_db_zone {
      component "users-db-service" as users_db_svc
      frame "users-db" as users_db_pod <<Pod>> {
        frame "Contenedor" as users_db_ctr_f {
          database "users_db" as users_db_ctr
        }
      }
    }
  }

  frame "posts-network" {
    frame "posts_app" as posts_app_zone {
      component "posts-app-service" as posts_app_svc
      frame "posts-app" as posts_app_pod <<Pod>> {
        frame "Contenedor" as posts_app_ctr_f {
          hexagon "posts_app" as posts_app_ctr
        }
      }
    }
    frame "posts_db" as posts_db_zone {
      component "posts-db-service" as posts_db_svc
      frame "posts-db" as posts_db_pod <<Pod>> {
        frame "Contenedor" as posts_db_ctr_f {
          database "posts_db" as posts_db_ctr
        }
      }
    }
  }

  frame "routes-network" {
    frame "routes_app" as routes_app_zone {
      component "routes-app-service" as routes_app_svc
      frame "routes-app" as routes_app_pod <<Pod>> {
        frame "Contenedor" as routes_app_ctr_f {
          hexagon "routes_app" as routes_app_ctr
        }
      }
    }
    frame "routes_db" as routes_db_zone {
      component "routes-db-service" as routes_db_svc
      frame "routes-db" as routes_db_pod <<Pod>> {
        frame "Contenedor" as routes_db_ctr_f {
          database "routes_db" as routes_db_ctr
        }
      }
    }
  }

  frame "offers-network" {
    frame "offers_app" as offers_app_zone {
      component "offers-app-service" as offers_app_svc
      frame "offers-app" as offers_app_pod <<Pod>> {
        frame "Contenedor" as offers_app_ctr_f {
          hexagon "offers_app" as offers_app_ctr
        }
      }
    }
    frame "offers_db" as offers_db_zone {
      component "offers-db-service" as offers_db_svc
      frame "offers-db" as offers_db_pod <<Pod>> {
        frame "Contenedor" as offers_db_ctr_f {
          database "offers_db" as offers_db_ctr
        }
      }
    }
  }
 }
}

circle "NodePort\n30000" as np_users
circle "NodePort\n30001" as np_posts
circle "NodePort\n30002" as np_routes
circle "NodePort\n30003" as np_offers

client ..> np_users
client ..> np_posts
client ..> np_routes
client ..> np_offers

np_users  -down-> users_app_svc  : "80"
np_posts  -down-> posts_app_svc  : "80"
np_routes -down-> routes_app_svc : "80"
np_offers -down-> offers_app_svc : "80"

users_app_svc  -down-> users_app_pod
posts_app_svc  -down-> posts_app_pod
routes_app_svc -down-> routes_app_pod
offers_app_svc -down-> offers_app_pod

users_app_pod  -down-> users_db_svc  : "5432"
posts_app_pod  -down-> posts_db_svc  : "5432"
routes_app_pod -down-> routes_db_svc : "5432"
offers_app_pod -down-> offers_db_svc : "5432"

users_db_svc  -down-> users_db_pod
posts_db_svc  -down-> posts_db_pod
routes_db_svc -down-> routes_db_pod
offers_db_svc -down-> offers_db_pod

legend left
  <b>Convenciones
  ----
  [ K8s / Node ]  alcance del clúster y del nodo
  [ <app>-network ]  NetworkPolicy: solo permite <app>-app -> <app>-db
  [ Pod ]  frame verde, agrupa un contenedor
  [ Contenedor ]  hexágono rosa (app) o cilindro azul (Postgres)
  Azul claro  Service - K8s
  Círculo  NodePort - K8s
  ..> Comunicación externa (NodePort)
  --> Tráfico permitido dentro del clúster
endlegend

@enduml
